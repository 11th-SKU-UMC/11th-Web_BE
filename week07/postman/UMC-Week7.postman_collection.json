{
  "info": {
    "name": "UMC Week7 Spring Boot JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"1a 회원가입\") { pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-7)); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1a 회원가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"a{{runId}}@umc.com\", \"nickname\": \"회원에이{{runId}}\", \"password\": \"Password1!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"code COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "1b 회원가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"b{{runId}}@umc.com\", \"nickname\": \"회원비{{runId}}\", \"password\": \"Password1!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"code COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2a 로그인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"a{{runId}}@umc.com\", \"password\": \"Password1!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"code COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"tokenA\", pm.response.json().result.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "2b 로그인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"b{{runId}}@umc.com\", \"password\": \"Password1!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"code COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"tokenB\", pm.response.json().result.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 A 평점 등록 (memberId 없음)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\"movieId\": 100, \"score\": 4.5, \"comment\": \"재미있어요\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"code COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));",
              "pm.collectionVariables.set(\"ratingId\", pm.response.json().result.ratingId);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 중복 등록 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\"movieId\": 100, \"score\": 4.5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"code RATING409_1\", () => pm.expect(pm.response.json().code).to.eql(\"RATING409_1\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5 본인 수정",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"score\": 5, \"comment\": \"수정 완료\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"code COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 B로 남의 평점 수정 403",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          }
        ],
        "url": "{{baseUrl}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"score\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"code RATING403_1\", () => pm.expect(pm.response.json().code).to.eql(\"RATING403_1\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7 토큰 없이 내 정보 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"code AUTH401_2\", () => pm.expect(pm.response.json().code).to.eql(\"AUTH401_2\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "8 없는 평점 삭제 404",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/ratings/99999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"code RATING404_1\", () => pm.expect(pm.response.json().code).to.eql(\"RATING404_1\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "9 본인 삭제 200",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/ratings/{{ratingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"code COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.test(\"삭제 result null\", () => pm.expect(pm.response.json().result).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "추가 내 정보 조회",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/members/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"code COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "추가 내 정보 수정",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/members/me",
        "body": {
          "mode": "raw",
          "raw": "{\"nickname\": \"변경{{runId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"code COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));"
            ]
          }
        }
      ]
    }
  ]
}