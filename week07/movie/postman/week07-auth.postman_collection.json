{
  "info": {
    "name": "UMC Week07 Spring — 인증과 인가",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"회원가입 A\") pm.collectionVariables.set(\"runId\", Date.now().toString(36));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "회원가입 A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a-{{runId}}@umc.com\",\n  \"nickname\": \"A{{runId}}\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "로그인 A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a-{{runId}}@umc.com\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"tokenA\", pm.response.json().result.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "회원가입 B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"b-{{runId}}@umc.com\",\n  \"nickname\": \"B{{runId}}\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "로그인 B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"b-{{runId}}@umc.com\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"tokenB\", pm.response.json().result.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "내 정보 조회",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/members/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "내 닉네임 수정",
      "request": {
