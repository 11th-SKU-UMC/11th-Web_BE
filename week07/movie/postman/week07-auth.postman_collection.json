              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"RATING409_1\", () => pm.expect(pm.response.json().code).to.eql(\"RATING409_1\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "본인 수정",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 4,\n  \"comment\": \"수정한 후기\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
