              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMMON200\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON200\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "다른 회원 수정 403",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 1\n}",
          "options": {
