              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"RATING403_1\", () => pm.expect(pm.response.json().code).to.eql(\"RATING403_1\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "토큰 없이 401",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 1\n}",
          "options": {
